# Copy to .env.local for local dev; set the same on Vercel for production.

# The brain. Get from https://platform.claude.com — without it, sessions still
# save and the app works; the brain just sits out.
ANTHROPIC_API_KEY=

# Gate for the deployed app (personal health data). Leave unset locally = open.
APP_PASSPHRASE=

# Set automatically by Vercel Postgres in production. Unset locally = JSON files in ./data
# POSTGRES_URL=
